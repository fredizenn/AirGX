# Virtual environment (like node_modules)
.venv/
venv/
env/

# Python bytecode caches (regenerated automatically)
__pycache__/
*.py[cod]

# Test and tool caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Build output
build/
dist/
*.egg-info/

# Secrets and local config
.env
.env.*
!.env.example

# Recordings and logs (we'll generate these from Episode 10 onward)
recordings/
*.log

# Editor and OS clutter
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store